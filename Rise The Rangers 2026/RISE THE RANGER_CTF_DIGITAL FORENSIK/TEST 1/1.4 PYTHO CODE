code = r'''import base64
import fitz  # PyMuPDF
import cv2
import numpy as np
from pathlib import Path

PDF_FILE = "boarding_pass (1).pdf"

def decode_qr_from_pdf(pdf_file: str) -> str:
    pdf_path = Path(pdf_file)
    if not pdf_path.exists():
        raise FileNotFoundError(f"File tidak ditemukan: {pdf_path}")

    detector = cv2.QRCodeDetector()

    with fitz.open(pdf_path) as pdf:
        for page_no, page in enumerate(pdf, start=1):
            # Render halaman PDF menjadi gambar dengan resolusi cukup tinggi.
            pix = page.get_pixmap(matrix=fitz.Matrix(4, 4), alpha=False)
            img = np.frombuffer(pix.samples, dtype=np.uint8)
            img = img.reshape(pix.height, pix.width, pix.n)

            # OpenCV memakai BGR.
            if pix.n == 3:
                img = cv2.cvtColor(img, cv2.COLOR_RGB2BGR)

            data, points, _ = detector.detectAndDecode(img)

            if data:
                print(f"[+] QR ditemukan pada halaman {page_no}")
                return data

    raise RuntimeError("QR Code tidak berhasil didecode.")

def main():
    raw = decode_qr_from_pdf(PDF_FILE)
    print(f"[+] Data QR: {raw}")

    try:
        decoded = base64.b64decode(raw).decode("utf-8")
        print(f"[+] Base64 decoded: {decoded}")
        print(f"[+] Flag: FLAG{{{decoded}}}")
    except Exception:
        print("[!] Data QR bukan Base64 yang valid.")
        print(f"[+] Gunakan data QR sebagai hasil: {raw}")

if __name__ == "__main__":
    main()
'''

